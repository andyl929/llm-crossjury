{
  "additionalProperties": false,
  "description": "Chair output for Document Review mode.\n\nedits is the merged, de-duplicated edit list. In the draft, edits whose\nacceptance depends on a dispute are omitted from edits and represented in\nsynthesis.disputed instead.",
  "properties": {
    "synthesis": {
      "additionalProperties": false,
      "description": "Chair output for Council mode (and the narrative part of Document Review).",
      "properties": {
        "consensus": {
          "items": {
            "additionalProperties": false,
            "description": "A point most or all members agree on.",
            "properties": {
              "statement": {
                "type": "string"
              },
              "supporting": {
                "description": "Anonymous labels of the members that support it.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "statement",
              "supporting"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "disputed": {
          "items": {
            "additionalProperties": false,
            "description": "A question on which members materially disagree.",
            "properties": {
              "id": {
                "description": "Unique within one Synthesis, e.g. \"d1\".",
                "type": "string"
              },
              "question": {
                "description": "The disagreement phrased as a neutral question.",
                "type": "string"
              },
              "positions": {
                "description": "At least two, one per distinct stance (labels may repeat across stances only\nif a member was internally inconsistent).",
                "items": {
                  "additionalProperties": false,
                  "description": "One side of a dispute.",
                  "properties": {
                    "label": {
                      "description": "Anonymous label of the member holding this position.",
                      "type": "string"
                    },
                    "stance": {
                      "description": "The position in one or two sentences.",
                      "type": "string"
                    },
                    "argument": {
                      "description": "The strongest reasoning offered for it, from the member's answer or reviews.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "stance",
                    "argument"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "chair_assessment": {
                "description": "The chair's own view, kept separate so the user can ignore it.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "question",
              "positions",
              "chair_assessment"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "unique": {
          "items": {
            "additionalProperties": false,
            "description": "Something only one member raised that the chair judges worth keeping.",
            "properties": {
              "label": {
                "type": "string"
              },
              "insight": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "insight"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "final_text": {
          "description": "None in the draft; the final answer in Markdown after adjudication.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "consensus",
        "disputed",
        "unique",
        "final_text"
      ],
      "type": "object"
    },
    "edits": {
      "items": {
        "additionalProperties": false,
        "description": "A single proposed change.",
        "properties": {
          "id": {
            "description": "Unique within one EditList, e.g. \"e3\".",
            "type": "string"
          },
          "location": {
            "additionalProperties": false,
            "description": "Where an edit applies.\n\noriginal in Edit is the authoritative anchor; these fields help a\nhuman find it and help the applier disambiguate repeated text.",
            "properties": {
              "section": {
                "description": "Heading path, e.g. \"3 Method > 3.2 Data\".",
                "type": [
                  "string",
                  "null"
                ]
              },
              "line_start": {
                "description": "1-based line in the submitted source, if known.",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "line_end": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "occurrence": {
                "description": "1-based occurrence index of original if it appears more than once.",
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "section",
              "line_start",
              "line_end",
              "occurrence"
            ],
            "type": "object"
          },
          "original": {
            "description": "Exact source text to be replaced (verbatim, including markup).",
            "type": "string"
          },
          "replacement": {
            "description": "New text. Empty string means deletion.",
            "type": "string"
          },
          "reason": {
            "description": "Why the change improves the document.",
            "type": "string"
          },
          "category": {
            "description": "Why an edit is proposed. Presets may restrict which categories are requested.",
            "enum": [
              "correctness",
              "clarity",
              "structure",
              "consistency",
              "citation",
              "style",
              "grammar",
              "formatting"
            ],
            "type": "string"
          },
          "severity": {
            "description": "How much an issue matters, from most to least severe.",
            "enum": [
              "critical",
              "major",
              "minor",
              "nit"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "location",
          "original",
          "replacement",
          "reason",
          "category",
          "severity"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "synthesis",
    "edits"
  ],
  "type": "object"
}
